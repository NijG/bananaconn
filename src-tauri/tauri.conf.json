{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BananaConn",
  "version": "0.7.49",
  "identifier": "com.administrator.bananaconn",
  "build": {
    "beforeDevCommand": "npm run build:rdp && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:rdp && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "BananaConn.",
        "width": 1360,
        "height": 860,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/bx-rdp"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      },
      "wix": {
        "upgradeCode": "{5DA65EA0-0D11-5EB4-9E69-A3C32182D9C2}"
      }
    },
    "publisher": "NijG",
    "copyright": "Copyright (c) 2026 BananaConn contributors"
  }
}
